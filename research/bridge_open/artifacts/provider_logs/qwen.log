093e\u0907\u0935\u0947\u091f \u092c\u0940\u091a \u0935\u0917\u0948\u0930\u0939 \u092d\u0940 \u0939\u0948 \u0928\u093e \u0939\u093e\u0930\u094d\u0921 \u0930\u0949\u0915\u094d\u0938 \u0915\u093e \u0905\u091a\u094d\u091b\u093e \u0939\u093e\u0901 \u0939\u093e\u0930\u094d\u0921 \u0930\u0949\u0915 \u0915\u093e \u092a\u0930 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u0939\u093e\u0901 \u0905\u0917\u0930 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u092c\u0940\u091a \u0930\u0939\u0947\u0917\u093e \u0924\u094b \u0914\u0930 \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092b\u093e\u092f\u0926\u0947 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902 \u0939\u092e\u094d\u092e \u0924\u094b \u0939\u093e\u0930\u094d\u0921 \u0930\u0949\u0915 \u0915\u0940 \u0915\u0902\u092a\u0928\u0940 \u092e\u0947\u0902 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0906\u0908 \u0925\u093f\u0902\u0915 \u0938\u094b \u092f\u093e \u092b\u093f\u0930 \u090f\u0915 \u0914\u0930 \u092e\u0938\u094d\u0924 \u0939\u094b\u091f\u0932 \u092e\u0947\u0902 \u0930\u093f\u0938\u0949\u0930\u094d\u091f \u092c\u093e\u0932\u0940 \u0906\u092f\u0928 \u0930\u093f\u0938\u0949\u0930\u094d\u091f \u092c\u093e\u0932\u0940 \u0935\u094b \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u094b \u0909\u0928\u0915\u093e \u092d\u0940 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u092c\u0940\u091a \u0910\u0938\u0940 \u0939\u0948 \u0906\u092f\u0928 \u0930\u093f\u0938\u0949\u0930\u094d\u091f \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0909\u0938\u0915\u093e \u092d\u0940 \u092a\u094d\u0930\u093e\u0907\u0938 \u0939\u0948 \u092f\u0947 \u0938\u0947\u0935\u0928 \u092f\u0947 \u092b\u093e\u0907\u0935 \u0938\u094d\u091f\u093e\u0930 \u0939\u0948 \u0907\u0938\u0915\u093e \u092a\u0930 \u0928\u093e\u0907\u091f \u092a\u0921\u093c \u0930\u0939\u093e \u0924\u0940\u0928 \u0925\u094d\u0930\u0940 \u092a\u0949\u0907\u0902\u091f \u0938\u093f\u0915\u094d\u0938 \u0932\u0948\u0915 \u0938\u092e\u0925\u093f\u0902\u0917 \u0939\u0948 \u0928\u093e \u0924\u094b \u092f\u0947 \u0906\u0908 \u0925\u093f\u0902\u0915 \u092e\u0947\u0930\u0947 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u092c\u0947\u0936 \u0930\u0939\u0947\u0917\u093e \u092c\u091c\u091f \u092e\u0947\u0902 \u092d\u0940 \u0939\u092e\u093e\u0930\u093e \u0906 \u091c\u093e\u090f\u0917\u093e \u092b\u093f\u091f \u0924\u0915\u093c\u093e\u0938 \u0905\u091a\u094d\u091b\u093e \u0939\u093e\u0901 \u0905\u091a\u094d\u091b\u093e \u092a\u0942\u0930\u093e \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u092a\u0947 \u091c\u093e\u090f\u0902\u0917\u0947 \u092a\u0942\u0930\u093e \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u091a\u093e\u0939\u093f\u090f \u0907\u0924\u0928\u093e \u0906 \u0930\u0939\u093e \u0939\u0948 \u0909\u0938\u0915\u093e \u0909\u0938\u0915\u093e \u0936\u093e\u092f\u0926 \u0905\u091a\u094d\u091b\u093e \u091a\u093e\u0930 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u092a\u0947 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u091c\u093f\u0924\u0928\u093e \u092e\u093e\u0932\u0942 \u090f\u0915 \u0939\u0948 \u091a\u093e\u0930 \u092e\u0947\u0902 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u0924\u094b \u0938\u0940\u091f\u0930 \u0915\u093f\u0938\u0940 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u0905\u0917\u0930 \u0926\u0947\u0916\u094b\u0917\u0947 \u0915\u093f\u0924\u0928\u0947 \u0915\u093f\u0924\u0928\u0947 \u0938\u0940\u091f\u0930\u094d\u0938 \u0915\u093e \u0939\u0948 \u092c\u0930\u093e\u092c\u0930 \u091f\u0947\u0928 \u0938\u0940\u091f\u0930\u094d\u0938 \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u091f\u0947\u0928 \u0938\u0940\u091f\u0930\u094d\u0938 \u0928\u0939\u0940\u0902 \u0924\u094b \u0938\u0940\u091f\u0930 \u0915\u094d\u092f\u093e \u0915\u0930 \u0924\u0941\u092e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u094b \u0924\u094b \u092c\u0947\u0938\u094d\u091f \u0939\u094b\u090f\u0917\u093e \u0910\u0938\u0947 \u0924\u094b \u0924\u0942 \u0928\u0939\u0940\u0902 \u092b\u094b\u0930 \u0938\u0940\u091f\u0930\u094d\u0938 \u092b\u094b\u0930 \u0938\u0940\u091f\u0930 \u0939\u093e\u0901 \u092b\u094b\u0930 \u0938\u0940\u091f\u0930 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u092b\u093f\u0930 \u0924\u0941\u092e\u0915\u094b \u0913 \u0939\u092e\u0947\u0902 \u0939\u092e\u093e\u0930\u093e \u092e\u0947\u0902\u092c\u0930 \u0939\u0948 \u092c\u093e\u0930\u093e \u092e\u0924\u0932\u092c \u0924\u0940\u0928 \u091a\u093e\u0930 \u0939\u093e\u0901 \u092e\u0924\u0932\u092c \u0939\u093e\u0901 \u091a\u093e\u0930 \u0939\u0940 \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u0932\u0917 \u0930\u0939\u093e \u0939\u0948 \u0938\u094b\u0932\u0939 \u0939\u093e\u0901 \u0938\u094b\u0932\u0939 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0930\u0916\u0932\u094b \u0939\u092e\u093e\u0930\u094b \u091c\u094b \u0932\u0917\u0947\u091c \u0935\u0917\u0948\u0930\u0939 \u091c\u093e\u090f\u0917\u093e \u0909\u0938 \u0924\u094b \u092d\u0940 \u091c\u093e\u090f\u0917\u093e \u0924\u094b \u092a\u093e\u0901\u091a \u0915\u0930\u0932\u094b \u092c\u0941\u0915 \u0939\u0948 \u0928\u093e \u092a\u093e\u0901\u091a \u092c\u0941\u0915 \u0915\u0930\u0932\u094b \u0905\u091a\u094d\u091b\u093e \u0939\u093e\u0901 \u092a\u093e\u0901\u091a \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u091c\u0947\u091f \u092c\u0941\u0915 \u0915\u0930\u0932\u094b \u0906\u0928\u0947 \u091c\u093e\u0928\u0947 \u0915\u093e \u0909\u0927\u0930 \u0915\u093e \u0914\u0930 \u0939\u0947\u0932\u0940\u0915\u0949\u092a\u094d\u091f\u0930 \u092d\u0940 \u0909\u0927\u0930 \u0930\u0916\u0928\u093e \u0939\u094b\u091f\u0932 \u0938\u0947 \u092c\u093e\u0924 \u0915\u0930\u0932\u094b \u0939\u0947\u0932\u0940\u0915\u0949\u092a\u094d\u091f\u0930 \u0930\u0916\u0928\u0947 \u0915\u093e \u0939\u0948 \u0928\u093e \u0939\u0947\u0932\u0940\u0915\u0949\u092a\u094d\u091f\u0930 \u092c\u0938 \u0930\u0916\u0928\u0947 \u0915\u094b \u0939\u092e \u092c\u093e\u0924 \u0915\u0930 \u0932\u0940 \u0939\u0948 \u0909\u0938\u0915\u093e \u092a\u094d\u0930\u093e\u0907\u0935\u0947\u091f \u092f\u094b\u0930\u094d\u0921 \u0935\u0917\u0948\u0930\u0939 \u0938\u092c \u0915\u0941\u091b \u0939\u093e\u0901 \u0914\u0930 \u090f\u0915 \u092c\u0924\u093e\u0928\u093e \u0939\u092e \u0939\u0947\u0932\u0940\u0915\u0949\u092a\u094d\u091f\u0930 \u092e\u0947\u0928 \u0939\u0948 \u0928\u093e \u0939\u093e\u0901 \u0939\u093e\u0901 \u0926\u094b \u0924\u0940\u0928 \u092f\u0949\u091f \u092c\u0941\u0915 \u0915\u0930 \u092c\u091a\u094d\u091a\u093e \u092f\u0949\u091f \u092a\u0947 \u0939\u0940 \u0938\u0947\u0915 \u0915\u0930\u0947\u0902\u0917\u0947 \u090f\u0915 \u0926\u093f\u0928 \u092a\u0942\u0930\u093e \u092f\u0949\u091f \u0932\u0915\u094d\u0938\u0930\u0940 \u0939\u0948 \u0928\u093e \u0932\u0915\u094d\u0938\u0930\u0940 \u092e\u0947\u0902 \u092e\u0948\u0902 \u0915\u0902\u092a\u094d\u0930\u094b\u092e\u093e\u0907\u091c\u093c \u0928\u0939\u0940\u0902 \u0915\u0930\u0942\u0901\u0917\u093e \u092a\u0949\u0932\u0940\u092e\u093f\u092f\u092e \u0906\u0939 \u0917\u094b\u0932\u094d\u0921 \u092c\u093e\u0924 \u0924\u092c \u0935\u0917\u0948\u0930\u0939 \u0938\u092c \u0915\u0941\u091b \u0939\u0948 \u0909\u0927\u0930 \u0928\u093e \u0938\u092c \u0915\u0941\u091b \u0938\u092c \u0915\u0941\u091b \u0914\u0930 \u092f\u0949\u091f \u092e\u0947\u0902 \u0935\u094b \u0939\u0947\u0932\u0940\u0915\u0949\u092a\u094d\u091f\u0930 \u0909\u0924\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 \u0939\u093e\u0901 \u0939\u093e\u0901 \u0939\u093e\u0901 \u092c\u0921\u093c\u093e \u0932\u093f\u092f\u093e \u0939\u0948 \u0905\u091a\u094d\u091b\u093e \u092c\u0921\u093c\u093e \u092f\u0949\u091f \u0939\u0948 \u0915\u093f\u0924\u0928\u093e \u092f\u0949\u091f \u0932\u093f\u092f\u093e \u090f\u0915-\u090f\u0915 \u092f\u094b\u091f \u092a\u0947 \u0915\u093f\u0924\u0928\u093e \u0932\u094b\u0917? \u0926\u0947\u0916\u094b \u090f\u0915 \u092a\u0942\u0930\u093e \u092c\u0921\u093c\u093e \u0932\u0947\u0915\u0947 \u0930\u0916\u0947\u0902 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u0938\u092c \u0906 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092e\u0924\u0932\u092c \u092c\u0940\u0938 \u0906\u0926\u092e\u0940 \u0915\u093e \u0915\u0948\u092a\u0947\u0938\u093f\u091f\u0940 \u0935\u093e\u0932\u093e\u0964 \u0924\u094b \u0909\u0938\u092e\u0947\u0902 \u092c\u0940\u0938 \u090f\u0915 \u0938\u0939\u0940 \u0920\u0940\u0915 \u0939\u0948\u0964 \u0909\u0938\u092e\u0947\u0902 \u0939\u092e \u0938\u094b\u0932\u0939 \u092e\u0902\u0926\u0947 \u0914\u0930 \u0909\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u0925 \u0939\u0930 \u090f\u0915 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915-\u090f\u0915 \u092f\u094b\u091f \u0909\u0916\u093e\u0921\u093c \u0915\u0930 \u0926\u094b\u0964 \u092e\u0924\u0932\u092c \u0938\u094b\u0932\u0939 \u0914\u0930 \u092f\u094b\u091f\u0964 \u0928\u0939\u0940\u0902 \u0939\u0930 \u090f\u0915 \u0939\u0930 \u090f\u0915 \u0915\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948 \u0928\u0939\u0940\u0902 \u092d\u093e\u0908 \u0915\u092a\u093f\u0932\u094d\u0938 \u0935\u0917\u0948\u0930\u0939 \u0939\u0948 \u0928\u093e \u0924\u094b \u0905\u091a\u094d\u091b\u093e \u0905\u091a\u094d\u091b\u093e \u090f\u0915-\u090f\u0915 \u0915\u092a\u093f\u0932 \u0924\u094b \u0932\u093f\u090f \u090f\u0915-\u090f\u0915 \u0915\u0930\u0915\u0947 \u0939\u092e \u0930\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u092b\u093f\u0930 \u092d\u0940 \u0938\u0939\u0940 \u0939\u0948, \u092b\u093f\u0930 \u092d\u0940 \u0938\u0939\u0940 \u0939\u0948\u0964 \u0924\u094b \u092b\u093f\u0930 \u0938\u094b\u0932\u0939 \u0939\u093e\u0901, \u0924\u094b \u092b\u093f\u0930 \u0906\u0920 \u091a\u093e\u0939\u093f\u090f, \u0924\u094b \u0906\u0920 \u092f\u0942\u091f\u094d\u0938\u0964 \u090f\u0902\u0921 \u090f\u0915 \u092e\u0947\u0928 \u0930\u0916\u094b \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u090f\u0915 \u092e\u0947\u0928\u0940 \u092f\u0942\u091f\u094d\u0938 \u092a\u0947 \u0914\u0930 \u091c\u092c \u091c\u093e\u090f\u0917\u093e \u0928\u093e \u0924\u094b \u092c\u0940\u091a \u092e\u0947\u0902 \u0910\u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u094b \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u092f\u0942\u091f\u094d\u0938 \u0915\u093f \u0938\u092c \u092a\u0942\u0930\u093e \u090f\u0915\u0926\u092e \u092c\u0921\u093c\u093e \u090f\u0915 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092c\u0928\u0964 \u0939\u093e\u0901, \u092c\u093f\u091c\u092f \u092d\u093e\u0908, \u092e\u0941\u0915\u0947\u0936 \u092d\u093e\u0908 \u0914\u0930 \u0935\u094b \u091c\u094b \u0938\u0932\u092e\u093e\u0928 \u092d\u093e\u0908 \u0939\u0948 \u0935\u094b \u0932\u094b\u0917 \u092c\u094b\u0932 \u0930\u0939\u0947 \u0925\u0947 \u0915\u093f \u0939\u093e\u0901 \u090f\u0915 \u092c\u0921\u093c\u093e \u092f\u0942\u091f\u094d\u0938 \u0930\u0916\u093f\u090f \u091c\u093f\u0927\u0930 \u0939\u092e \u0938\u092c \u090f\u0915 \u0938\u093e\u0925 \u092c\u0948\u0920 \u0915\u0947 \u092a\u093e\u0930\u094d\u091f\u0940 \u0935\u0917\u0948\u0930\u0939 \u0915\u0930 \u0938\u0915\u0947 \u0914\u0930 \u090f\u0915 \u092c\u0921\u093c\u093e \u092d\u0940 \u0930\u0916 \u0926\u0940\u0964 \u0939\u093e\u0901 \u0939\u093e\u0901 \u0905\u091a\u094d\u091b\u093e \u0905\u091a\u094d\u091b\u093e \u0905\u091a\u094d\u091b\u093e \u0920\u0940\u0915 \u0913\u0915\u0947\u0964 \u092a\u0942\u0930\u093e \u092f\u0942\u0906\u0930\u092a\u0940 \u0932\u0917\u0926\u093e\u0930\u0940 \u0938\u0930\u094d\u0935\u093f\u0938\u0947\u091c \u0914\u0930 \u091c\u094b \u092d\u0940 \u0906\u090f\u0917\u093e \u092e\u0924\u0932\u092c \u0939\u092e\u093e\u0930\u093e \u091c\u094b \u0938\u0947\u0928\u093e \u0909\u0938\u092a\u0947 \u0915\u094b\u0908 \u0915\u092e\u0940 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u092a\u0942\u0930\u093e \u0938\u092c \u0915\u0941\u091b \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0939\u092e \u092c\u0941\u0915 \u0915\u0930\u0935\u093e \u0926\u093f\u090f\u0964 \u0905\u091a\u094d\u091b\u093e \u0920\u0940\u0915 \u0939\u0948 \u0920\u0940\u0915 \u0939\u0948 \u0914\u0930 \u0939\u094b\u091f\u0932 \u0915\u093e \u092e\u0948\u0902\u0928\u0947 \u0905\u092d\u0940 \u091c\u094b \u092c\u094b\u0932\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0915\u094b \u0915\u0948\u0902\u0938\u0932 \u0915\u094b \u0928\u092f\u093e \u0915\u0930\u0924\u0947 \u0939\u094b \u0909\u0938\u0915\u094b \u090f\u0921\u0935\u093e\u0902\u0938 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e \u0906\u0939 \u0935\u0928 \u0915\u0930\u094b\u0921\u093c \u0938\u092e\u0925\u093f\u0902\u0917 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0940 \u091a\u0940\u091c\u093c \u0925\u093e \u0909\u0938\u092e\u0947\u0902 \u0938\u0947 \u091b\u094b\u0921\u093c\u094b \u0935\u0928 \u0915\u0930\u094b\u0921\u093c \u0924\u094b \u0915\u094d\u092f\u093e \u0939\u0940 \u0939\u0948\u0964 \u092c\u0941\u0915 \u0915\u0930 \u0932\u094b \u0926\u0942\u0938\u0930\u093e, \u0915\u094d\u092f\u093e \u0928\u093e\u0964 \u0928\u0939\u0940\u0902 \u0939\u092e \u0939\u092e \u092a\u0947\u092e\u0947\u0902\u091f \u0935\u0917\u0948\u0930\u0939 \u0928\u0939\u0940\u0902 \u0915\u093f\u090f \u0914\u0930 \u092c\u093e\u0924 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948 \u092e\u0947\u0930\u0947 \u0915\u094b\u0964 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930 \u0926\u094b, \u092c\u094b\u0932 \u0930\u0939\u0947 \u0925\u0947\u0964 \u090f\u0915\u0926\u092e \u092a\u0942\u0930\u093e\u0964 \u0939\u093e\u0901\u0964 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0915\u0930\u0915\u0947 \u0930\u0916\u094b\u0964 \u0939\u093e\u0901 \u0939\u093e\u0901 \u0939\u093e\u0901\u0964 \u0939\u092e\u093e\u0930\u093e \u0921\u0947\u091f \u092b\u093f\u0915\u094d\u0938\u0964 \u0913 \u0915\u093f\u0924\u0928\u093e \u0925\u093e \u090f\u0915 \u092e\u093e\u0930\u094d\u091a \u0915\u094b \u0915\u0930\u0947\u0902\u0917\u0947\u0964 \u092b\u0930\u094d\u0938\u094d\u091f \u092e\u093e\u0930\u094d\u091a \u0915\u094b \u092f\u093e \u0920\u0940\u0915 \u0939\u0948 \u0928\u093e\u0964 \u0928\u0939\u0940\u0902 \u092b\u0930\u094d\u0938\u094d\u091f \u092e\u093e\u0930\u094d\u091a \u0915\u094b \u092e\u0941\u0915\u0947\u0936 \u092d\u093e\u0908 \u0915\u093e \u092e\u0940\u091f\u093f\u0902\u0917 \u0939\u0948 \u092c\u094b\u0932 \u0930\u0939\u0947 \u0925\u0947 \u0924\u094b\u0964 \u092e\u0940\u091f\u093f\u0902\u0917 \u0915\u0948\u0902\u0938\u093f\u0932 \u0915\u0930\u0935\u093e \u0926\u094b\u0964 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0924\u094b \u0928\u093e \u092e\u0948\u0902\u0928\u0947 \u0938\u092c\u0938\u0947 \u092c\u093e\u0924 \u0915\u0930 \u0932\u0940 \u0939\u0948 \u0907\u0938 \u0924\u0930\u092b \u0915\u0947 \u0924\u0930\u092b\u0964 \u0905\u0930\u0947 \u092e\u0948\u0902 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u0925\u0930\u094d\u0921 \u092e\u093e\u0930\u094d\u091a \u0938\u0947 \u0938\u092c\u0915\u093e \u0939\u094b \u091c\u093e\u090f\u0917\u093e \u0905\u091a\u094d\u091b\u093e \u0925\u0930\u094d\u0921 \u092e\u093e\u0930\u094d\u091a \u092e\u093e\u0930\u094d\u091a \u092c\u0941\u0915 \u0915\u0930 \u0926\u094b \u0920\u0940\u0915 \u0939\u0948 \u0915\u093f \u0924\u092e \u0925\u0930\u094d\u0921 \u092e\u093e\u0930\u094d\u091a \u0915\u094b \u0939\u0940 \u0939\u092e\u0947\u0902 \u091a\u093e\u0939\u093f\u090f \u092a\u0942\u0930\u093e \u092b\u0948\u0938\u093f\u0932\u093f\u091f\u0940 \u090f\u0902\u0921 \u0939\u092e\u093e\u0930\u093e \u091c\u094b \u092e\u0947\u0928 \u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0939\u094b\u0917\u093e \u092e\u0941\u0902\u092c\u0908 \u0938\u0947 \u0939\u092e\u093e\u0930\u093e \u092a\u0942\u0930\u093e \u092b\u094d\u0932\u093e\u0907\u091f \u0930\u0939\u0947\u0917\u093e \u0905\u0932\u094d\u0932 \u0906\u0909\u091f \u0911\u092b \u0938\u094d\u091f\u0947\u0936\u0928 \u092e\u0941\u0902\u092c\u0908 \u0938\u0947 \u091c\u094b \u0932\u094b\u0917 \u092d\u0940 \u0939\u0948\u0902 \u0909\u0928\u0915\u0947 \u0932\u093f\u090f \u090f\u0915-\u090f\u0915 \u0930\u094b\u091c \u0932\u0949\u092f\u0932\u094d\u0938 \u092d\u0947\u091c \u0926\u0947\u0928\u093e \u0909\u0928\u0915\u0947 \u0918\u0930 \u0939\u093e\u0901 \u0939\u093e\u0901 \u0926\u094b \u092d\u0947\u091c\u0928\u093e \u090f\u0915\u094d\u091a\u0941\u0905\u0932\u0940 \u092e\u0948\u0902 \u0926\u094b \u092d\u0947\u091c\u0928\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u090f\u0915 \u092e\u0947\u0902 \u0935\u094b \u0932\u094b\u0917 \u0906\u090f\u0902\u0917\u0947 \u0924\u094b \u0926\u0942\u0938\u0930\u0947 \u092e\u0947\u0902 \u0909\u0928\u0915\u093e \u0932\u0917\u0947 \u091c\u0940 \u092d\u0940 \u0932\u093e\u0928\u093e \u092a\u0921\u093c\u0947\u0917\u093e \u0928\u093e \u0939\u093e\u0901 \u0939\u093e\u0901 \u0924\u094b \u0930\u094b\u091c\u093c \u0932\u0949\u092f\u0938 \u092d\u0947\u091c\u0928\u093e \u092f\u093e \u092b\u093f\u0930 \u092e\u0941\u0915\u0947\u0936 \u0915\u094b \u0906\u0908 \u0925\u093f\u0902\u0915 \u0938\u094b \u0930\u094b\u091c\u093c \u0932\u0949\u092f\u0938 \u091a\u093e\u0939\u093f\u090f \u090f\u0902\u0921 \u0938\u0932\u092e\u093e\u0928 \u0906\u0908 \u0925\u093f\u0902\u0915 \u0938\u094b \u092c\u094b\u0932 \u0930\u0939\u093e \u0925\u093e \u0935\u094b \u092b\u093c\u0930\u093e\u0930\u0940 \u092e\u0947\u0902 \u0924\u094b \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u092b\u093c\u0930\u093e\u0930\u0940 \u092d\u0947\u091c \u0926\u0947\u0928\u093e \u0926\u094b \u091a\u093e\u0930 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0909\u0938\u092e\u0947\u0902 \u0906 \u091c\u093e\u090f\u0917\u093e \u0920\u0940\u0915 \u0939\u0948 \u0928\u093e \u0920\u0940\u0915 \u0939\u0948 \u0939\u093e\u0901 \u0909\u0938\u092e\u0947\u0902 \u0932\u093e\u0928\u093e \u092c\u094d\u0932\u0921 \u092b\u093c\u0949\u0930\u094d\u092e \u092c\u0947\u091a \u091c\u0948\u0928 \u091c\u094b \u091c\u0939\u093e\u0901 \u092a\u0947 \u0930\u0939\u0924\u093e \u0939\u0948 \u0935\u0939\u093e\u0901 \u092a\u0947 \u092d\u0947\u091c \u0926\u0947\u0928\u093e \u0915\u0939\u0940\u0902 \u092a\u0930 \u0939\u094b \u0920\u0940\u0915 \u0939\u0948 \u0928\u093e \u0939\u093e\u0901 \u0939\u093e\u0901 \u0918\u0930 \u092a\u0947 \u092d\u0947\u091c \u0926\u0947\u0928\u093e \u090f\u0915\u0926\u092e \u092a\u0942\u0930\u093e \u0932\u0917\u0947\u091c \u0932\u0947\u0915\u0947 \u0906 \u091c\u093e\u090f\u0917\u093e \u090f\u0902\u0921 \u092b\u094d\u0932\u093e\u0907 \u0915\u0930 \u091c\u093e\u090f\u0917\u093e \u0935\u0939\u093e\u0901 \u0938\u0947 \u090f\u092f\u0930\u092a\u094b\u0930\u094d\u091f \u092e\u0947\u0902 \u0930\u0916\u093e \u0939\u0940 \u0939\u094b\u0917\u093e \u0906\u0908 \u0925\u093f\u0902\u0915 \u0938\u094b \u0909\u0927\u0930 \u0938\u0947 \u0926\u0947\u0916\u0924\u0947 \u0914\u0930 \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u0906\u0924\u0947 \u0939\u0948\u0902 \u092c\u091c\u091f \u0915\u093e \u0907\u0938\u0942 \u0928\u0939\u0940\u0902 \u092c\u091c\u091f \u0924\u094b \u092c\u0939\u0941\u0924 \u0939\u0940 friendly \u092c\u0928 \u0930\u0939\u093e \u0939\u0948 \u092c\u091c\u091f \u0907\u0938\u0915\u093e \u0907\u0924\u0928\u093e \u0915\u0941\u091b \u0915\u093e\u092e \u0939\u093e\u0901 \u092d\u093e\u0908 \u0938\u093e\u092c \u0905\u092d\u0940 \u0905\u092d\u0940 \u0905\u092d\u0940 \u0905\u092d\u0940 \u0930\u094b\u0939\u0924\u0928 \u0915\u093e \u0906\u0936\u093e \u0915\u093f\u0938\u0940 \u0915\u093e \u092e\u0948\u0938\u0947\u091c \u0906\u092f\u093e \u0939\u0948 \u0935\u094b \u092d\u0940 \u091c\u093e\u0928\u093e \u091a\u093e\u0939 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0939\u092e \u0920\u0940\u0915 \u0924\u094b \u0939\u0948 \u0930\u094b\u0939\u0924\u0928 \u0915\u093e \u0906\u0936\u093e \u0915\u0940 \u092b\u093f\u0930 \u0914\u0930 \u0926\u094b \u0939\u092e\u0947\u0902 \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0939\u092e \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0924\u094b \u0915\u0930\u0915\u0947 \u0939\u0940 \u0930\u0916\u0947 \u0939\u0948\u0902 \u0930\u094b\u0939\u0924\u0928 \u0915