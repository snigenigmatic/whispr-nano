u0939 \u0935\u093e\u0932\u0947 \u092e\u0947\u0902 \u0928\u094d\u092f\u0942\u091c\u0940\u0932\u0948\u0902\u0921 \u0905\u092b\u0917\u093e\u0928\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u0939\u0948 \u0924\u094b \u0926\u0947\u0916\u0928\u0947 \u0932\u093e\u092f\u0915 \u092e\u0948\u091a \u0924\u094b \u0928\u094d\u092f\u0942\u091c\u0940\u0932\u0948\u0902\u0921 \u0905\u092b\u0917\u093e\u0928\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u0939\u094b\u0917\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0926\u094b\u0928\u094b\u0902 \u091f\u0940\u092e\u0947\u0902 \u0905\u091a\u094d\u091b\u0940 \u0916\u093e\u0924\u0940 \u0939\u0948\u0902 \u0939\u093e\u0932\u093e\u0902\u0915\u093f \u0928\u094d\u092f\u0942\u091c\u0940\u0932\u0948\u0902\u0921 \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0939\u0948 \u092c\u091f \u0905\u092b\u0917\u093e\u0928\u093f\u0938\u094d\u0924\u093e\u0928 \u092d\u0940 \u0920\u0940\u0915 \u0920\u093e\u0915 \u0939\u0948 \u0938\u093f\u0930\u093f\u0932\u0902\u0917\u093e \u0906\u092f\u0930\u0932\u0948\u0902\u0921 \u092e\u0947\u0902 \u092d\u0940 \u0926\u094b\u0928\u094b\u0902 \u0935\u0939\u0940 \u0935\u0939\u0940 \u091f\u093e\u0907\u092a \u092e\u0924\u0932\u092c \u090f\u0915 \u0939\u0940 \u0909\u0938\u092a\u0947 \u0930\u0916\u0942\u0902\u0917\u093e \u092e\u0948\u0902 \u0905\u092d\u0940 \u0930\u093e\u0907\u091f \u0928\u093e\u0909 \u0924\u094b \u092a\u0939\u0932\u0947 \u091c\u094b \u0938\u093f\u0930\u093f\u0932\u0902\u0917\u093e \u0939\u0941\u0906 \u0915\u0930\u0924\u093e \u0925\u093e \u0938\u0928\u0902\u0924 \u091c\u092f\u0938\u0942\u0930\u094d\u092f\u093e \u0938\u0902\u0917\u0915\u093e\u0930\u093e \u092e\u0932\u093f\u0902\u0917\u093e \u091c\u0948\u0938\u0947 \u090f\u0915\u094d\u0938\u091f\u094d\u0930\u093e\u0928\u0930\u0940 \u092c\u0949\u0932\u0930 \u0915\u0941\u0932\u0936\u0947\u0916\u0928\u093e \u092e\u0941\u0925\u093f\u092f\u093e \u092e\u0941\u0930\u0932\u0940\u0927\u0930\u0928 \u0935\u094b \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0905\u0932\u0917 \u0939\u0941\u0906 \u0915\u0930\u0924\u093e \u0925\u093e \u0905\u092d\u0940 \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u092e\u0947\u0902 \u0905\u0917\u0930 \u0936\u093e\u092f\u0926 \u092a\u0942\u091b\u093e \u091c\u093e\u090f \u090f\u0915 \u0922\u0902\u0917 \u0915\u0947 \u092a\u094d\u0932\u0947\u092f\u0930 \u0915\u093e \u0928\u093e\u092e \u092c\u0924\u093e \u0926\u094b \u091c\u094b \u0935\u0930\u094d\u0932\u094d\u0921 \u0915\u094d\u0932\u093e\u0938 \u0939\u094b \u0928\u0939\u0940\u0902 \u092c\u0924\u093e \u092a\u093e\u0913\u0917\u0947 \u0939\u092e\u094d\u092e \u092c\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0938\u0939\u0940 \u0939\u0948 \u092e\u0924\u0932\u092c \u0938\u092c\u0938\u0947 \u0918\u0930\u093e\u0935 \u0921\u093e\u0909\u0928\u092b\u0949\u0932 \u0905\u0917\u0930 \u0915\u093f\u0938\u0940 \u0915\u093e \u0906\u092f\u093e \u0939\u0941\u0906 \u0939\u0948 \u0924\u094b \u0935\u0947\u0938\u094d\u091f\u0907\u0902\u0921\u0940\u091c \u0924\u094b \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0915\u0939\u0940\u0902 \u0906\u092f\u093e \u0939\u0948 \u092d\u093e\u0908 \u0915\u094d\u092f\u093e \u091f\u0940\u092e \u0939\u0941\u0906 \u0915\u0930\u0924\u093e \u0925\u093e \u092d\u093e\u0908 \u0932\u093e\u0907\u0915 \u090f\u0915 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u092a\u093e\u0915\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u092d\u0940 \u0939\u0948 \u0921\u093e\u0909\u0928\u092b\u0949\u0932 \u092a\u093e\u0915\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u092d\u0940 \u0939\u0948 \u0939\u092e\u094d\u092e \u0924\u0940\u0928\u094b\u0902 \u091f\u0940\u092e \u0915\u093e \u0928\u093e\u092e \u092c\u094b\u0932\u094b \u092a\u0930 \u092d\u093e\u0908 \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0925\u093e \u091f\u0949\u092a \u0925\u094d\u0930\u0940 \u092e\u0947\u0902 \u0905\u0917\u0930 \u0915\u093f\u0938\u0940 \u0915\u093e \u0928\u093e\u092e \u0932\u0947\u0924\u0947 \u0925\u0947 \u0924\u094b \u0907\u0902\u0917\u094d\u0932\u0948\u0902\u0921 \u0928\u0939\u0940\u0902 \u0930\u0939\u0924\u093e \u0925\u093e \u092c\u0932\u094d\u0915\u093f \u0938\u092e \u0928\u093e \u091f\u0949\u092a \u0925\u094d\u0930\u0940 \u092e\u0947\u0902 \u0905\u0917\u0930 \u091f\u0949\u092a \u0925\u094d\u0930\u0940 \u0915\u0940 \u092c\u093e\u0924 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901 \u0907\u0902\u0921\u093f\u092f\u093e \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0914\u0930 \u092f\u0947 \u0905\u092a\u0928\u093e \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u090f\u0915 \u092f\u0939\u0940 \u091f\u0949\u092a \u0925\u094d\u0930\u0940 \u0939\u0941\u0906 \u0915\u0930\u0924\u0947 \u0925\u0947 \u0928\u094b \u0938\u0949\u0930\u0940 \u0938\u093e\u0909\u0925 \u0905\u092b\u094d\u0930\u0940\u0915\u093e \u092d\u0940 \u092e\u093e\u0928 \u0932\u094b \u091f\u0949\u092a \u0925\u094d\u0930\u0940 \u092e\u0947\u0902 \u0907\u0927\u0930 \u0909\u0927\u0930 \u092f\u0947 \u091a\u093e\u0930 \u091a\u093e\u0930 \u0930\u0939\u0924\u0947 \u0925\u0947, \u092f\u0947 \u0924\u094b \u0907\u0902\u0917\u094d\u0932\u0948\u0902\u0921 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0906\u092f\u093e\u0964 \u0907\u0902\u0917\u094d\u0932\u0948\u0902\u0921 \u0905\u091a\u094d\u091b\u093e \u0925\u093e \u0938\u094d\u091f\u093e\u0930\u094d\u091f\u093f\u0902\u0917 \u0938\u0947 \u092a\u0930 \u0909\u0924\u0928\u093e \u090f\u0915\u094d\u0938\u094d\u091f\u094d\u0930\u093e \u0911\u0930\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u0925\u093e \u091c\u093f\u0924\u0928\u093e \u0905\u092c \u0939\u0948\u0964 \u0939\u092e\u094d\u092e, \u0905\u092d\u0940 \u0907\u0902\u0917\u094d\u0932\u0948\u0902\u0921 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0939\u094b \u0917\u0908, \u0907\u0902\u0917\u094d\u0932\u0948\u0902\u0921 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0939\u094b \u0917\u0908 \u0939\u0948, \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0907\u0902\u0921\u093f\u092f\u093e \u092d\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0939\u094b \u0917\u0908 \u0939\u0948, \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0924\u094b \u0939\u092e\u0947\u0936\u093e \u0938\u0947 \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0925\u0940\u0964 \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e, \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0924\u094b \u092d\u093e\u0908 \u092a\u0948\u0926\u093e \u0939\u0940 \u0938\u094d\u091f\u094d\u0930\u0949\u0902\u0917 \u0939\u0941\u0908 \u0925\u0940, \u0910\u0938\u093e \u0932\u0917\u0924\u093e \u0939\u0948 \u092d\u093e\u0908, \u0915\u092d\u0940 \u0915\u092d\u0940 \u0909\u0928\u0915\u093e \u0928\u093e \u0921\u093e\u0909\u0928\u092b\u0949\u0932 \u0906\u092f\u093e \u0928\u093e \u0915\u0941\u091b \u0906\u092f\u093e, \u0939\u092e\u0947\u0936\u093e \u0935\u094b \u091f\u0949\u092a \u092a\u0947 \u0915\u092e \u0932\u093f\u0938\u094d\u091f \u0915\u0902\u092a\u093f\u091f\u0940\u091f\u0930 \u092e\u0947\u0902 \u0930\u0939\u0947 \u0915\u0902\u0917\u093e\u0930\u0942\u091c\u093c \u0915\u0902\u0917\u093e\u0930\u0942\u091c\u093c \u0915\u093e \u0932\u0947\u0935\u0932 \u0939\u0940 \u0935\u0948\u0938\u093e \u0939\u0948 \u0914\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0938\u093e\u0909\u0925 \u0905\u092b\u094d\u0930\u0940\u0915\u093e \u0924\u094b \u092e\u0924\u0932\u092c \u0939\u092e\u0947\u0936\u093e \u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u0925\u0940 \u0935\u094b \u091c\u0948\u0938\u0947 \u0925\u0940 \u0935\u0948\u0938\u0947 \u092f\u0947 \u092d\u0940 \u092d\u0940 \u0939\u0948 \u0914\u0930 \u092e\u0924\u0932\u092c \u092a\u093e\u0915\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u092e\u0924\u0932\u092c \u092a\u093e\u0915\u093f\u0938\u094d\u0924\u093e\u0928 \u0915\u093e \u0921\u093e\u0909\u0928\u092b\u0949\u0932 \u090f\u0915\u0926\u092e \u0928\u0939\u0940\u0902 \u0915\u0939 \u0938\u0915\u0924\u0947 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092c\u0940\u091a \u092c\u0940\u091a \u092e\u0947\u0902 \u0938\u0940\u0930\u0940\u091c \u091c\u0940\u0924 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0910\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0924\u094b \u092c\u0940\u091a \u092e\u0947\u0902 \u090f\u0915\u0926\u092e \u0916\u0930\u093e\u092c \u0939\u094b \u0917\u0908 \u0925\u0940 \u0905\u092c \u0932\u0947\u0915\u093f\u0928 \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0915\u093e \u091a\u092c\u094d\u092c\u0940\u0938 \u0925\u094b\u0921\u093c\u0947 \u092a\u094d\u0932\u0947\u092f\u0930 \u0905\u091a\u094d\u091b\u0947 \u0939\u0948\u0902 \u0925\u094b\u0921\u093c\u0947 \u092c\u0939\u0941\u0924 \u092e\u0924\u0932\u092c \u091c\u0940\u0924 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0924\u0947\u091c\u093c \u0935\u094b \u092d\u0940 \u0916\u0947\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902 \u092a\u0949\u0907\u0902\u091f\u0930 \u092d\u0940 \u0925\u094b\u0921\u093c\u0947 \u0925\u094b\u0921\u093c\u0947 \u092c\u0939\u0941\u0924 \u0920\u0940\u0915 \u0925\u093e \u0915\u0947 \u092a\u0930 \u0905\u092d\u0940 \u092d\u0940 \u092e\u0924\u0932\u092c \u0930\u093f\u0915\u0935\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948 \u0936\u094d\u0930\u0940\u0932\u0902\u0915\u093e \u0935\u0947\u0938\u094d\u091f\u0907\u0902\u0921\u0940\u091c \u0924\u094b \u0932\u0917\u092d\u0917 \u0924\u094b \u0921\u0947\u0921 \u0939\u094b \u0917\u0908 \u0939\u0948 \u092d\u093e\u0908 \u0909\u0938\u092e\u0947\u0902 \u092e\u0924\u0932\u092c \u091c\u094b \u0905\u091a\u094d\u091b\u0947 \u092a\u094d\u0932\u0947\u092f\u0930 \u0939\u0948\u0902 \u0905\u091a\u094d\u091b\u0947 \u092a\u094d\u0932\u0947\u092f\u0930 \u0939\u0948\u0902 \u0909\u0928\u0915\u0940 \u0935\u094b \u0916\u0947\u0932\u0928\u093e \u0928\u0939\u0940\u0902 \u091a\u093e\u0939\u0924\u0947 \u091c\u094b \u092a\u0948\u0938\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0924\u093e \u0909\u0928\u0915\u094b \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902 \u092c\u0947\u091a\u093e\u0930\u0947 \u091c\u0948\u0938\u0947 \u0906\u092a \u0909\u0928\u0915\u0947 \u0935\u094b \u0932\u0940\u0917 \u0926\u0947\u0916\u094b \u091c\u094b \u0915\u0948\u0930\u0947\u092c\u093f\u092f\u0928 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u0930 \u0932\u0940\u0917 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0909\u0938\u092e\u0947\u0902 \u091c\u094b \u092a\u094d\u0932\u0947\u092f\u0930\u094d\u0938 \u0916\u0947\u0932\u0924\u0947 \u0939\u0948\u0902 \u0935\u094b \u092d\u0940 \u092a\u094d\u0932\u0947\u092f\u0930 \u0935\u0947\u0938\u094d\u091f\u0907\u0902\u0921\u0940\u091c \u091f\u0940\u092e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0916\u0947\u0932\u0924\u0947 \u091c\u094b \u0924\u0917\u0921\u093c\u0947 \u092a\u094d\u0932\u0947\u092f\u0930\u094d\u0938 \u0939\u0948\u0902 \u0907\u0928\u0915\u0947 \u092a\u093e\u0938 \u0911\u0932\u0930ounder \u0915\u0940 \u0915\u092e\u0940 \u0925\u094b\u0921\u093c\u0940 \u0939\u0948 \u092d\u093e\u0908 \u092a\u0942\u0930\u093e \u091f\u0940\u092e \u0939\u0940 \u0911\u0932\u0930ounder \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948 \u092a\u0930 \u0935\u0939\u0940 \u091a\u0940\u091c \u0939\u0948 \u0915\u094d\u0930\u093f\u0915\u0947\u091f \u092c\u094b\u0930\u094d\u0921 \u0939\u0940 \u0916\u0930\u093e\u092c \u0939\u0948 \u0907\u0928\u0915\u093e \u0915\u0939 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948 \u092a\u093e\u092a\u0940 \u0909\u0928\u0915\u0947 \u092a\u093e\u0938 \u092a\u0948\u0938\u093e \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902 \u0939\u092e\u094d\u092e \u092f\u0947 \u092d\u0940 \u0938\u0939\u0940 \u092c\u093e\u0924 \u0939\u0948 \u0909\u0928\u0915\u0947 \u092a\u094d\u0932\u0947\u092f\u0930 \u091c\u093e \u091c\u093e \u0915\u0947 \u0905\u0932\u0917 \u0905\u0932\u0917 \u0915\u0902\u091f\u094d\u0930\u0940\u091c \u092e\u0947\u0902 \u0932\u0940\u0917 \u0916\u0947