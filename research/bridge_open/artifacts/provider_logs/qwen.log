u0924\u094b \u0915\u0941\u091b \u0921\u093f\u0938\u094d\u0915\u093e\u0909\u0902\u091f \u0906\u0908 \u0925\u093f\u0902\u0915 \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0938\u093e\u0907\u0921 \u0938\u0947 \u092e\u093f\u0932\u0947\u0917\u093e \u0926\u0938 \u092a\u0902\u0926\u094d\u0930\u0939 \u0938\u093e\u0932 \u0911\u092b \u0906\u0908 \u0925\u093f\u0902\u0915 \u090f\u0915-\u090f\u0915 \u0915\u0947 \u090a\u092a\u0930 \u0906 \u091c\u093e\u090f\u0917\u093e \u0905\u091a\u094d\u091b\u093e \u0939\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0939\u0948\u0902 \u0915\u093f \u092c\u091c\u091f \u0925\u094b\u0921\u093c\u093e \u090f\u092a\u094d\u092a\u0930\u0947\u092c\u0932 \u0939\u0940 \u0930\u0916\u0947\u0902 \u092a\u093e\u0930 \u0939\u0947\u0921 \u0938\u0947\u0935\u0947\u0902\u091f\u0940 \u091f\u0942 \u0928\u093e\u0907\u0928\u091f\u0940 \u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0939\u0940 \u0909\u0938\u0915\u0947 \u0906\u0938\u092a\u093e\u0938 \u0939\u0940 \u0930\u0916 \u0926\u0947\u0902\u0917\u0947\u0964 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902, seventy two ninety \u0915\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u093e \u0939\u094b\u0917\u093e \u0928\u0939\u0940\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092c\u093e\u0932\u0940 \u092e\u0947\u0902 \u0935\u0939\u093e\u0901 \u092a\u0947 \u091c\u094b \u091f\u0942\u0930\u093f\u0938\u094d\u091f \u0915\u093e \u0939\u0948 \u0928\u093e, \u0939\u092e just like \u092a\u0942\u0930\u093e \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0907\u0938 \u092c\u093e\u0930 \u0935\u094b \u092a\u094d\u0932\u093e\u0928 \u092e\u0947\u0902 \u0907\u0902\u0915\u094d\u0932\u0942\u0921 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902 \u0938\u092c\u0938\u0947 \u092c\u093e\u0924 \u092d\u0940 \u0939\u094b\u0917\u093e \u0925\u0947 \u0939\u092e\u093e\u0930\u0947 \u0917\u094d\u0930\u0941\u092a \u0938\u0947, \u0935\u094b \u0932\u094b\u0917 \u092d\u0940 \u0938\u0939\u0940 \u0939\u0948\u0902\u0964 \u0909\u0928\u0915\u094b \u092c\u094b\u0932\u093e \u0915\u093f \u092c\u091c\u091f \u0915\u093e \u0907\u0938 \u0909\u0928\u092a\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948, \u092c\u091c\u091f \u0915\u093e \u0915\u094b\u0908 \u0924\u094b \u092c\u091c\u091f \u0924\u094b \u092c\u093e\u0926 \u092e\u0947\u0902 \u0921\u093f\u0938\u093e\u0907\u0921 \u0915\u0930\u0947\u0902\u0917\u0947, \u092a\u0939\u0932\u0947 \u092f\u0947 \u0938\u092c \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0909\u0938 \u0939\u093f\u0938\u093e\u092c \u0938\u0947 \u092c\u091c\u091f \u0939\u092e\u0947\u0902 \u0921\u093f\u0938\u093e\u0907\u0921 \u0915\u0930\u0928\u093e \u0939\u0948, \u0939\u0948 \u0928\u093e? \u0909\u0927\u0930 \u0905\u0917\u0930 \u0939\u092e \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u092b\u0930\u094d\u0938\u094d\u091f \u092e\u0947\u0902 \u0939\u0941\u090f \u0932\u0915\u093e\u092e \u0935\u0917\u0948\u0930\u0939 \u091c\u092c \u092d\u0940 \u0939\u094b\u0917\u093e \u0939\u092e\u093e\u0930\u0947 \u091c\u093f\u0924\u0928\u0947 \u092d\u0940 \u0917\u0947\u0938\u094d\u091f \u0939\u0948\u0902 \u0909\u0928\u0915\u094b \u0917\u094b\u0932\u094d\u0921 \u091a\u0948\u0928 \u092a\u0939\u0928\u093e \u0915\u094d\u092f\u093e \u0939\u0948 \u0928\u093e \u0924\u094b \u0916\u093e\u0928\u0947 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0930\u0916\u0947 \u0916\u093e\u0928\u0947 \u092e\u0947\u0902 \u092e\u0924\u0932\u092c \u0916\u093e\u0928\u0947 \u0915\u094d\u092f\u093e \u0939\u0948? \u092b\u093f\u0930 \u092e\u0924\u0932\u092c \u0909\u0938\u0915\u093e \u091c\u094b \u0932\u094b\u0915\u0932\u094d\u0938 \u0939\u0948\u0902, \u0935\u094b \u0938\u092c \u0916\u093e\u0928\u093e \u0930\u0916\u0947\u0902\u0917\u0947 \u0915\u093f \u092f\u093e \u092b\u093f\u0930 \u0907\u0902\u0921\u093f\u092f\u0928 \u0938\u0947\u0964 \u0928\u0939\u0940\u0902, \u0907\u0902\u0921\u093f\u092f\u093e\u0928\u094d\u0938 \u0906\u0939 \u0926\u094b-\u0924\u0940\u0928 \u0926\u093f\u0928 \u0907\u0902\u0921\u093f\u092f\u093e\u0928\u094d\u0938 \u0915\u0930\u0947\u0902\u0917\u0947, \u0907\u0902\u0921\u093f\u092f\u093e\u0928\u094d\u0938 \u091c\u094d\u092f\u093e\u0926\u093e \u0928\u0939\u0940\u0902 \u0930\u0916\u0947\u0902\u0917\u0947\u0964 \u092c\u093e\u0915\u0940 \u0905\u0932\u0917-\u0905\u0932\u0917 \u091a\u0940\u091c\u093c \u0924\u0941\u092e\u0915\u094b \u0930\u0916\u0928\u093e \u0939\u094b\u0917\u093e \u0928\u093e? \u091a\u093e\u0907\u0928\u0940\u091c\u093c, \u091c\u093e\u092a\u0928\u0940\u091c\u093c \u0914\u0930 \u092c\u093e\u0932\u0940 \u0915\u093e \u0924\u094b \u0939\u0930 \u090f\u0915 \u091a\u0940\u091c\u093c\u0964 \u0924\u094b \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u0930\u0916\u0928\u093e \u0939\u094b\u0917\u093e? \u0935\u0939\u0940 \u090f\u0915 \u092c\u093e\u0924 \u0939\u0948\u0964 \u0905\u091a\u094d\u091b\u093e \u0939\u092e \u0938\u094b\u091a \u0930\u0939\u0947 \u0915\u093f \u092a\u0939\u0932\u0947 \u0926\u093f\u0928 \u090f\u0930\u093e\u0907\u0935\u0932 \u0915\u0947 \u092c\u093e\u0926 \u0909\u0927\u0930 \u0939\u092e \u092b\u094d\u0930\u093e\u0907\u0921 \u0930\u093e\u0907\u0938, \u092b\u094d\u0930\u093e\u0907\u0921 \u0928\u0942\u0921\u0932\u094d\u0938 \u0914\u0930 \u091f\u094b\u0938\u094d\u091f\u094d\u0938 \u090f\u0917\u094d\u0938 \u092f\u0947 \u0925\u094b\u0921\u093c\u093e \u091a\u0940\u092a \u0932\u0917 \u0930\u0939\u093e \u0939\u0948 \u092e\u0947\u0930\u0947 \u0915\u093e \u0926\u093f\u0928 \u0939\u0948 \u0928\u093e \u0928\u0939\u0940\u0902 \u0928\u0939\u0940\u0902 \u092f\u0947 \u0924\u094b \u0939\u092e \u0928\u0949\u0930\u094d\u092e\u0932 \u0939\u0940 \u092c\u0924\u093e \u0930\u0939\u0947 \u0939\u0948\u0902 \u0907\u0938\u0915\u093e \u0905\u0932\u0917 \u0905\u0932\u0917 \u0935\u0948\u0930\u093e\u092f\u091f\u0940 \u0930\u0916\u0947\u0902\u0917\u0947 \u0939\u093e\u0901 \u091c\u094b \u0939\u092e \u0915\u0930\u0947\u0902\u0917\u0947 \u0928\u093e \u092a\u0924\u093e \u0939\u0948 \u0928\u093e \u0932\u093e\u092f\u0928 \u0932\u093e\u092f\u0928 \u092a\u0924\u093e \u0939\u0948 \u0928\u093e \u0932\u093e\u092f\u0928 \u0915\u094b \u0939\u092e \u092e\u0940\u091f \u0930\u0916\u0947\u0902\u0917\u0947 \u0909\u0938\u0915\u093e \u091c\u094b \u092d\u0940 \u0939\u094b\u0924\u093e \u0939\u0948 \u0916\u093e\u0928\u0947 \u092e\u0947\u0902 \u0914\u0930 \u091c\u094b \u0932\u094b\u0917 \u0935\u0947\u091c\u093f\u091f\u0947\u0930\u093f\u092f\u0928\u094d\u0938 \u0939\u0948\u0902 \u0935\u0947\u091c\u093f\u091f\u0947\u0930\u093f\u092f\u0928\u094d\u0938 \u091c\u094b \u0932\u094b\u0917 \u0939\u0948\u0902 \u0935\u0947\u091c\u093f\u091f\u0947\u0930\u093f\u092f\u0928\u094d\u0938 \u0917\u094d\u0930\u0941\u092a \u092a\u0947 \u0939\u0948 \u0928\u0939\u0940\u0902 \u0939\u092e\u093e\u0930\u093e \u0914\u0930 \u0926\u0947\u0916\u093e \u091c\u093e\u090f \u0924\u094b \u0935\u0947\u091c\u093f\u091f\u0947\u0930\u093f\u092f\u0928\u094d\u0938 \u0915\u0947 \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947 \u092a\u0928\u0940\u0930 \u0915\u093e \u0921\u093f\u0938\u0947\u0938\u0940 \u0915\u0930 \u092f\u0947 \u0930\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0939\u093e\u0901 \u0935\u0947\u091c\u093f\u091f\u0947\u0930\u093f\u092f\u0928\u094d\u0938 \u0915\u093e \u0938\u0940\u0928 \u0935\u094b \u0932\u094b\u0917 \u0924\u094b \u0938\u092c \u091a\u0932 \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0909\u0927\u0930 \u0909\u0927\u0930 \u0939\u092e\u093e\u0930\u093e \u0938\u094d\u092a\u0947\u0936\u0932 \u0939\u0948 \u0928\u093e\u0936\u0940 \u0906\u092f\u092e \u0935\u094b \u091a\u093f\u0915\u0928 \u0930\u093e\u0907\u0938 \u091f\u093e\u0907\u092a \u0915\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0935\u094b \u0924\u094b \u090f\u0915 \u0915\u0930\u0947\u0902\u0917\u0947 \u0939\u092e \u0920\u0940\u0915 \u0939\u0948 \u0928\u093e \u0905\u091a\u094d\u091b\u093e \u092c\u093e\u0932\u093f\u0915\u093e \u0935\u094b \u0938\u094d\u092a\u0947\u0936\u0932 \u0939\u0948 \u0930\u093e\u0924 \u092e\u0947\u0902 \u0926\u094b\u092a\u0939\u0930 \u0915\u094b \u0939\u0940 \u0906\u092f\u092e \u092c